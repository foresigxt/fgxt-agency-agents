{
  "name": "@foresigxt/agency-agents",
  "version": "0.3.0",
  "description": "Markdown-authored agency agents + SKILL.md skills. Builds the @foresigxt/agency-agents artifact contract (dist/agents.json + dist/skills.json) consumed by fgxt-app-web.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./agents.json": "./dist/agents.json",
    "./skills.json": "./dist/skills.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/build.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "vendor": "node scripts/vendor-upstream.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foresigxt/fgxt-agency-agents.git"
  },
  "license": "UNLICENSED"
}
